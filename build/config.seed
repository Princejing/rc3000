CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
# 多设备 Profile 模式：只有显式选中的设备才会被编出镜像（否则只编 subtarget 默认参考机）
CONFIG_TARGET_MULTI_PROFILE=y
# OpenWrt 设备选择符号格式：CONFIG_TARGET_DEVICE_<board>_<subtarget>_DEVICE_<profile>
# profile 名【原样小写】（target-metadata.pl L313 铁证：$profile->{id} 原样插入符号，
# 无 uc() 无清洗；PACKAGES 变体是 string 类型不能 =y）。前缀必须 TARGET_DEVICE_。
# cmcc_mr3000d-ci 之所以总被编出，是它是 ipq50xx 默认设备，与符号无关。
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_rc3000=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBIFS=y

CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_CCACHE=y

# 无线（IPQ5018 集成 2.4G 用 kmod-ath11k；QCN6102 5G PCIe 用 kmod-ath11k-pci）
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-h3c_rc3000=y

# NSS 硬件加速（ImmortalWrt 相对主线 OpenWrt 的优势；
# 若首次编译报包不存在，直接删掉这两行即可，不影响基础启动）
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y

# 交换机（外部 QCA8337，DSA 模型）
CONFIG_PACKAGE_kmod-dsa-qca8k=y

# LuCI 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-ttyd=y

# NAND 工具（备份/救砖必备）
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_kmod-mtd-rw=y

# 常用
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_htop=y

# 下载源：GitHub runner 访问 immortalwrt 源站（mirror/downloads.immortalwrt.org）返回 403/404，
# 导致 host 工具源码（lz4/xxHash/fakeroot/libtool…）下载失败、编译早期即崩。
# 改用 OpenWrt 官方源（已实测 downloads.openwrt.org/sources 含所需文件且对 runner 可达）。
CONFIG_DOWNLOAD_MIRROR="https://downloads.openwrt.org/sources"
